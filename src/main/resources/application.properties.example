# Server Configuration
server.port=8080

# File Upload Limits (Security)
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# Application Name
spring.application.name=ResumeAnalyzer

# Serve static files from filesystem (override embedded JAR resources)
# This allows CSS/HTML/JS edits without rebuilding
spring.web.resources.static-locations=file:src/main/resources/static/,classpath:/static/

# AI Configuration
# Copy this file to application.properties and set your real key below.
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
